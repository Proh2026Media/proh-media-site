# Modelo do arquivo de ambiente. Na VPS, copie para ".env" e preencha.
# O .env real NUNCA vai para o repositório — ele vive só no servidor.
#
#   cp .env.exemplo .env
#   nano .env

# Endereço público da API (o subdomínio que aponta para a VPS).
SERVER_URL=https://api.proh.media

# Chave de acesso da API. Gere uma forte na própria VPS:
#   openssl rand -hex 32
API_KEY=cole_aqui_a_chave_gerada

# Senha do banco. Gere outra, diferente da de cima:
#   openssl rand -hex 24
POSTGRES_PASSWORD=cole_aqui_a_senha_gerada
