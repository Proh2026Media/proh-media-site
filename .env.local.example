# Copie este arquivo para .env.local (opcional).
#
# O simulador de IA chama /api/gemini.php — um proxy PHP no próprio site
# (Hostinger) que guarda a chave FORA da pasta pública. Em produção nada
# precisa ser configurado aqui.
#
# Para testar o simulador rodando o site localmente (npm run dev), aponte
# para o proxy do site publicado:
# VITE_GEMINI_PROXY_URL=https://proh.media/api/gemini.php
